# ========================================================
# Clinic Dashboard (Next.js) - Environment Variables Template
# Copy this file to .env.local and fill in your credentials.
# NEVER commit your real .env.local file to version control.
# ========================================================

NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# LiveKit Cloud (Used by the in-browser WebRTC testing phone)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret
