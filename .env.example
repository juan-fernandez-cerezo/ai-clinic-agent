# ========================================================
# ProsperAI Clinic - Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit your real .env file to version control.
# ========================================================

# LiveKit Cloud (https://cloud.livekit.io)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Models & Audio Services
OPENAI_API_KEY=your_openai_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
CARTESIA_API_KEY=your_cartesia_api_key

# Supabase PostgreSQL Database (https://supabase.com)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key

# Clinic Backend EHR API
EHR_BASE_URL=http://127.0.0.1:8000

# Telegram Notifications (Optional, via @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id
